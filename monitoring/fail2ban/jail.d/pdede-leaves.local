[DEFAULT]
destemail = apettas@gmail.com
sender = andpettas@sch.gr
sendername = Adeies Fail2Ban
# Ελληνικό mail με οδηγίες (monitoring/fail2ban/action.d/pdede-mail.conf)
action = pdede-mail[name=%(__name__)s, dest="%(destemail)s", sender="%(sender)s", sendername="%(sendername)s"]

ignoreip = 127.0.0.1/8 ::1 10.32.0.0/16

bantime  = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled  = true
port     = ssh
logpath  = /var/log/auth.log
backend  = auto

[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch-pdede
logpath  = %(nginx_logpath)s/access.log
maxretry = 2
findtime = 5m
bantime  = 24h

[nginx-http-auth]
enabled  = true
port     = http,https
filter   = nginx-http-auth
logpath  = %(nginx_logpath)s/access.log
maxretry = 10
findtime = 5m
bantime  = 1h

[nginx-limit-req]
enabled  = true
port     = http,https
filter   = nginx-limit-req
logpath  = %(nginx_logpath)s/error.log
maxretry = 10
findtime = 2m
bantime  = 1h

[nginx-bad-request]
enabled  = true
port     = http,https
filter   = nginx-bad-request
logpath  = %(nginx_logpath)s/access.log
maxretry = 10
findtime = 2m
bantime  = 30m
